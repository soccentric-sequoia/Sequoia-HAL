# =============================================================================
# Write statements declared in CMakeLists.txt:
# /workspace/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for STATIC_LIBRARY target lib_base


#############################################
# Order-only phony target for lib_base

build cmake_object_order_depends_target_lib_base: phony || src/CMakeFiles/lib_base.dir

build src/CMakeFiles/lib_base.dir/lib_base.cpp.o: CXX_COMPILER__lib_base_ /workspace/src/lib_base.cpp || cmake_object_order_depends_target_lib_base
  DEP_FILE = src/CMakeFiles/lib_base.dir/lib_base.cpp.o.d
  FLAGS = -Wall -Wextra -Wpedantic -Werror -fPIC -std=gnu++17
  INCLUDES = -I/workspace/src
  OBJECT_DIR = src/CMakeFiles/lib_base.dir
  OBJECT_FILE_DIR = src/CMakeFiles/lib_base.dir
  TARGET_COMPILE_PDB = src/CMakeFiles/lib_base.dir/lib_base.pdb
  TARGET_PDB = lib/liblib_base.pdb


# =============================================================================
# Link build statements for STATIC_LIBRARY target lib_base


#############################################
# Link the static library lib/liblib_base.a

build lib/liblib_base.a: CXX_STATIC_LIBRARY_LINKER__lib_base_ src/CMakeFiles/lib_base.dir/lib_base.cpp.o
  LANGUAGE_COMPILE_FLAGS = -Wall -Wextra -Wpedantic -Werror
  OBJECT_DIR = src/CMakeFiles/lib_base.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = src/CMakeFiles/lib_base.dir/lib_base.pdb
  TARGET_FILE = lib/liblib_base.a
  TARGET_PDB = lib/liblib_base.pdb


#############################################
# Utility command for package

build src/CMakeFiles/package.util: CUSTOM_COMMAND src/all
  COMMAND = cd /workspace/build/cross && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build src/package: phony src/CMakeFiles/package.util


#############################################
# Utility command for package_source

build src/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross && /usr/bin/cpack --config ./CPackSourceConfig.cmake /workspace/build/cross/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build src/package_source: phony src/CMakeFiles/package_source.util


#############################################
# Utility command for test

build src/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross/src && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build src/test: phony src/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross/src && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/edit_cache: phony src/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross/src && /usr/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build/cross
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/rebuild_cache: phony src/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/list_install_components: phony


#############################################
# Utility command for install

build src/CMakeFiles/install.util: CUSTOM_COMMAND src/all
  COMMAND = cd /workspace/build/cross/src && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/install: phony src/CMakeFiles/install.util


