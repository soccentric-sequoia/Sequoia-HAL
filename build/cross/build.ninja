build src/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/all
  COMMAND = cd /workspace/build/cross/src && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
