#############################################
# Utility command for package

build protos/CMakeFiles/package.util: CUSTOM_COMMAND protos/all
  COMMAND = cd /workspace/build/cross && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build protos/package: phony protos/CMakeFiles/package.util


#############################################
# Utility command for package_source

build protos/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross && /usr/bin/cpack --config ./CPackSourceConfig.cmake /workspace/build/cross/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build protos/package_source: phony protos/CMakeFiles/package_source.util


#############################################
# Utility command for test

build protos/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross/protos && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build protos/test: phony protos/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build protos/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross/protos && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build protos/edit_cache: phony protos/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build protos/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/cross/protos && /usr/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build/cross
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build protos/rebuild_cache: phony protos/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build protos/list_install_components: phony


#############################################
# Utility command for install

build protos/CMakeFiles/install.util: CUSTOM_COMMAND protos/all
  COMMAND = cd /workspace/build/cross/protos && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build protos/install: phony protos/CMakeFiles/install.util


#############################################
# Utility command for install/local

build protos/CMakeFiles/install/local.util: CUSTOM_COMMAND protos/all
  COMMAND = cd /workspace/build/cross/protos && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build protos/install/local: phony protos/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build protos/CMakeFiles/install/strip.util: CUSTOM_COMMAND protos/all
  COMMAND = cd /workspace/build/cross/protos && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build protos/install/strip: phony protos/CMakeFiles/install/strip.util


